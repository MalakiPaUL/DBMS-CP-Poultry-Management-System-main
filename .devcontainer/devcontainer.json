{
  "name": "Poultry Farm Management System",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/var/www/html",
  "shutdownAction": "stopCompose",
  "forwardPorts": [80],
  "portsAttributes": {
    "80": {
      "label": "Poultry Farm Management System",
      "onAutoForward": "openBrowser"
    }
  }
}
